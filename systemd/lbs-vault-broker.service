# Template rendered by scripts/install.sh (@...@ placeholders). Do not install by hand.
# Root broker: runs only root-approved templates from @DIR@/templates.json and
# feeds the secret on the child's stdin. It needs CAP_SETUID/SETGID for
# template run_as and normal network for ssh targets, so it is less confined
# than lbs-vault.service. Only uid-0 peers may connect to its socket.
[Unit]
Description=LBS vault broker (template-scoped secret use; socket /run/lbs-vault-broker/broker.sock)
After=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=LBS_VAULT_DIR=@DIR@
Environment=LBS_VAULT_BROKER_SOCKET=/run/lbs-vault-broker/broker.sock
Environment=LBS_VAULT_TEMPLATES=@DIR@/templates.json
Environment=PYTHONPATH=@PREFIX@/lib
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
WorkingDirectory=@PREFIX@/lib
ExecStart=/usr/bin/python3 -s -B -m lbs_vault.broker
UMask=0077
RuntimeDirectory=lbs-vault-broker
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5
KillMode=control-group
LimitCORE=0
# Templates cannot gain privileges through setuid binaries (local `sudo` is
# therefore unusable inside a template; remote `ssh ... sudo -S` works).
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
